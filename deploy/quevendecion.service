[Unit]
Description=QueVendecion API
After=network.target

[Service]
WorkingDirectory=/opt/apps/quevendecion
ExecStart=/opt/apps/quevendecion/QueVendecion.Api
Restart=always
RestartSec=10

# Ambiente
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5010

# Secrets — CAMBIAR estos valores
Environment=Jwt__Key=TU_SECRET_AQUI
Environment=ConnectionStrings__DefaultConnection=Host=SERVIDOR_BD;Port=5432;Database=quevendecion;Username=USUARIO;Password=VALOR_PRIVADO

[Install]
WantedBy=multi-user.target
